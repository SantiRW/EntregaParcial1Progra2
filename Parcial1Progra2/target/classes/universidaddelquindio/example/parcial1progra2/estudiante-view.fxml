<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="universidaddelquindio.example.parcial1progra2.Controllers.EstudianteController">

    <top>
        <VBox spacing="5"
              style="-fx-background-color: #1f4e79; -fx-padding: 20;">

            <Label text="LINGUAPLUS"
                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label text="Gestión de estudiantes"
                   style="-fx-text-fill: white; -fx-font-size: 18px;"/>

        </VBox>
    </top>

    <center>

        <VBox spacing="20">
            <padding>
                <Insets top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <Label text="Registrar estudiante"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="10"
                      vgap="12">

                <Label text="Nombre completo:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre completo"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>


                <Label text="Documento:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtDocumento"
                           promptText="Documento"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>


                <Label text="Teléfono:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtTelefono"
                           promptText="Teléfono"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>


                <Label text="Correo:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtCorreo"
                           promptText="Correo electrónico"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>


                <Label text="Edad:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtEdad"
                           promptText="Edad"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>


                <Label text="Fecha de registro:"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="dpFechaRegistro"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="1"/>

            </GridPane>


            <HBox spacing="10">

                <Button text="Registrar estudiante"
                        onAction="#registrarEstudiante"
                        style="-fx-background-color: #2e75b6; -fx-text-fill: white;"/>

                <Button text="Limpiar"
                        onAction="#limpiarFormulario"/>

            </HBox>


            <Label text="Estudiantes registrados"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>


            <TableView fx:id="tablaEstudiantes"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="columnaNombre"
                                 text="Nombre"
                                 prefWidth="180"/>

                    <TableColumn fx:id="columnaDocumento"
                                 text="Documento"
                                 prefWidth="120"/>

                    <TableColumn fx:id="columnaTelefono"
                                 text="Teléfono"
                                 prefWidth="120"/>

                    <TableColumn fx:id="columnaCorreo"
                                 text="Correo"
                                 prefWidth="200"/>

                    <TableColumn fx:id="columnaEdad"
                                 text="Edad"
                                 prefWidth="70"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>