<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="universidaddelquindio.example.parcial1progra2.Controllers.MatriculaController">

    <top>
        <VBox spacing="5"
              style="-fx-background-color: #1f4e79;">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="GESTIÓN DE MATRÍCULAS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Registro y administración de matrículas de estudiantes"
                   style="-fx-text-fill: #d9eaf7; -fx-font-size: 13px;"/>
        </VBox>
    </top>


    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>


            <!-- ===================================================== -->
            <!-- FORMULARIO DE MATRÍCULA -->
            <!-- ===================================================== -->

            <VBox spacing="10"
                  style="-fx-background-color: #f4f6f8;
                         -fx-background-radius: 8;
                         -fx-border-color: #d0d7de;
                         -fx-border-radius: 8;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Datos de la matrícula"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f4e79;"/>


                <GridPane hgap="12" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>


                    <!-- Número -->

                    <Label text="Número:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtNumero"
                               promptText="Ej: 1001"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>


                    <!-- Estudiante -->

                    <Label text="Estudiante:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"/>

                    <ComboBox fx:id="comboEstudiante"
                              promptText="Seleccione estudiante"
                              maxWidth="Infinity"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="0"/>


                    <!-- Programa -->

                    <Label text="Programa:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <ComboBox fx:id="comboPrograma"
                              promptText="Seleccione programa"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>


                    <!-- Fecha -->

                    <Label text="Fecha de inicio:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"/>

                    <DatePicker fx:id="fechaInicio"
                                promptText="Seleccione fecha"
                                maxWidth="Infinity"
                                GridPane.columnIndex="3"
                                GridPane.rowIndex="1"/>


                    <!-- Descuento -->

                    <Label text="Descuento (%):"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="txtDescuento"
                               promptText="Ej: 10"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>


                    <!-- Tutor -->

                    <Label text="Docente / Tutor:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="comboDocente"
                              promptText="Seleccione docente"
                              maxWidth="Infinity"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="2"/>


                    <!-- Observaciones -->

                    <Label text="Observaciones:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <TextArea fx:id="txtObservaciones"
                              promptText="Escriba observaciones..."
                              prefRowCount="3"
                              wrapText="true"
                              GridPane.columnIndex="1"
                              GridPane.columnSpan="3"
                              GridPane.rowIndex="3"/>

                </GridPane>


                <!-- Botones principales -->

                <HBox spacing="10">

                    <Button text="Registrar matrícula"
                            onAction="#registrarMatricula"
                            style="-fx-background-color: #1f4e79;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;"/>

                    <Button text="Asignar tutor"
                            onAction="#asignarTutor"/>

                    <Button text="Limpiar"
                            onAction="#limpiarFormulario"/>

                </HBox>

            </VBox>


            <!-- ===================================================== -->
            <!-- SERVICIOS ADICIONALES -->
            <!-- ===================================================== -->

            <VBox spacing="10"
                  style="-fx-background-color: #f4f6f8;
                         -fx-background-radius: 8;
                         -fx-border-color: #d0d7de;
                         -fx-border-radius: 8;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Servicios adicionales"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f4e79;"/>


                <HBox spacing="12">

                    <VBox spacing="5"
                          HBox.hgrow="ALWAYS">

                        <Label text="Servicio:"/>

                        <ComboBox fx:id="comboServicio"
                                  promptText="Seleccione un servicio"
                                  maxWidth="Infinity"/>
                    </VBox>


                    <VBox spacing="5"
                          prefWidth="130">

                        <Label text="Cantidad:"/>

                        <TextField fx:id="txtCantidadServicio"
                                   promptText="Ej: 1"/>
                    </VBox>


                    <VBox spacing="5">

                        <Label text="Acción"/>

                        <Button text="Agregar servicio"
                                onAction="#agregarServicio"/>
                    </VBox>

                </HBox>

            </VBox>


            <!-- ===================================================== -->
            <!-- TOTAL -->
            <!-- ===================================================== -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="15">

                <Label text="TOTAL:"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblTotal"
                       text="0"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f4e79;"/>

                <Button text="Calcular total"
                        onAction="#calcularTotal"/>

                <Button text="Generar comprobante"
                        onAction="#generarComprobante"/>

            </HBox>

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Matrículas registradas"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f4e79;"/>


                <TableView fx:id="tablaMatriculas"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaNumero"
                                     text="Número"
                                     prefWidth="90"/>

                        <TableColumn fx:id="columnaEstudiante"
                                     text="Estudiante"
                                     prefWidth="190"/>

                        <TableColumn fx:id="columnaPrograma"
                                     text="Programa"
                                     prefWidth="190"/>

                        <TableColumn fx:id="columnaFecha"
                                     text="Fecha inicio"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaDescuento"
                                     text="Descuento"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaTotal"
                                     text="Total"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>